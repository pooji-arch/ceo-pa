# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- Database -----------------------------------------------------------
# Primary: Supabase Postgres. Get your connection string from the Supabase
# dashboard: Project Settings -> Database -> Connection string -> URI.
# Use the "Session pooler" (not Direct connection — that host is IPv6-only
# and unreachable on many networks; not the Transaction pooler either, which
# doesn't support the prepared statements Prisma migrations need). Copy it
# into your local .env, then replace [YOUR-PASSWORD] with the real database
# password. If the password contains any of @ : / ? # % [ ] or a space,
# percent-encode just that character (see README.md) or Prisma will fail to
# parse the URL.
#
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# For local development against your own Postgres instead of Supabase:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceo_pa_dev?schema=public"

# --- Parked: staging DB (set aside for now, see README.md) -----------------
# Staging (ceo_pa_staging on 15.252.10.156), reached through your own SSH
# tunnel. Not in use while we build against Supabase — kept here so the
# connection details aren't lost.
#
#   ssh -i <your-private-key> -N -L 5432:127.0.0.1:5432 ubuntu@15.252.10.156
#
# DATABASE_URL="postgresql://pooja:<password>@localhost:5432/ceo_pa_staging?schema=public"

# --- Server ---------------------------------------------------------------
# Not the common default 4000 — avoids colliding with other local projects.
PORT=4010
NODE_ENV=development
CORS_ORIGIN=http://localhost:5183

# --- Auth -------------------------------------------------------------------
# Generate your own with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Google OAuth ------------------------------------------------------------
# Password login works fully without this. Only needed for the "Continue with
# Google" button. Leave blank until you've set up a Google OAuth client:
#
# 1. https://console.cloud.google.com/apis/credentials -> Create Credentials
#    -> OAuth client ID -> Application type: Web application.
# 2. Authorized redirect URI: http://localhost:4010/auth/google/callback
#    (must match GOOGLE_CALLBACK_URL below exactly).
# 3. Copy the generated Client ID and Client Secret into your local .env.
#
# Google sign-in only works for an email that already has a CEO PA account
# (it links, never self-registers) — the seeded dev accounts use @ceopa.dev
# addresses, which aren't real Google accounts, so this can't be tested
# end-to-end until a real user's Google email is added via /auth/register
# or the seed data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4010/auth/google/callback
